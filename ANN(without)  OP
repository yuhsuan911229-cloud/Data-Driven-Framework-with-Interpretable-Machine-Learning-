# 27. SHAP ANALYSIS
# ============================================================

if RUN_FINAL_SHAP:

    print("\n" + "=" * 70)
    print("FINAL ANN SHAP ANALYSIS")
    print("=" * 70)

    transformed_feature_names = (
        final_preprocessor
        .get_feature_names_out()
        .tolist()
    )

    rng = np.random.default_rng(
        SHAP_RANDOM_STATE
    )

    if SHAP_EXPLAIN_SIZE is None:
        explain_idx = np.arange(
            len(X_final_processed)
        )
    else:
        n_explain = min(
            SHAP_EXPLAIN_SIZE,
            len(X_final_processed)
        )

        explain_idx = np.sort(
            rng.choice(
                len(X_final_processed),
                size=n_explain,
                replace=False
            )
        )

    X_explain = X_final_processed[explain_idx]

    n_background = min(
        SHAP_BACKGROUND_SIZE,
        len(X_final_processed)
    )

    background_idx = rng.choice(
        len(X_final_processed),
        size=n_background,
        replace=False
    )

    X_background = X_final_processed[
        background_idx
    ]

    def predict_function(data):
        return (
            final_model
            .predict(data, verbose=0)
            .reshape(-1)
        )

    explainer = shap.KernelExplainer(
        predict_function,
        X_background
    )

    shap_values_raw = explainer.shap_values(
        X_explain,
        nsamples=SHAP_NSAMPLES
    )

    shap_values = np.asarray(
        shap_values_raw
    )

    # Compatibility with SHAP versions returning (n, p, 1)
    if (
        shap_values.ndim == 3
        and shap_values.shape[-1] == 1
    ):
        shap_values = shap_values[..., 0]

    if shap_values.ndim != 2:
        raise ValueError(
            f"Unexpected SHAP value shape: {shap_values.shape}"
        )

    shap_keep_idx = [
        i
        for i, name
        in enumerate(transformed_feature_names)
        if not name.endswith(
            "IR compensation_missing"
        )
    ]

    expected_value = float(
        np.asarray(
            explainer.expected_value
        ).reshape(-1)[0]
    )

    explanation = shap.Explanation(
        values=shap_values[:, shap_keep_idx],
        base_values=np.repeat(
            expected_value,
            len(X_explain)
        ),
        data=X_explain[:, shap_keep_idx],
        feature_names=[
            transformed_feature_names[i]
            for i in shap_keep_idx
        ],
    )

    mean_abs_shap = np.abs(
        explanation.values
    ).mean(axis=0)

    sorted_index = np.argsort(
        mean_abs_shap
    )[::-1]

    print("\nSHAP Feature Importance:")

    for i in sorted_index:
        print(
            f"{explanation.feature_names[i]}: "
            f"{mean_abs_shap[i]:.4f}"
        )

    print(f"\nTraining samples   : {len(X_final_processed)}")
    print(f"Background samples : {len(X_background)}")
    print(f"Explained samples  : {len(X_explain)}")
    print(f"Features shown     : {len(shap_keep_idx)}")

    # SHAP bar
    plt.figure(figsize=(6, 5))

    shap.plots.bar(
        explanation,
        max_display=SHAP_MAX_DISPLAY,
        show=False
    )

    fig = plt.gcf()
    ax = plt.gca()

    for patch in ax.patches:
        patch.set_facecolor(SHAP_BAR_COLOR)
        patch.set_edgecolor(SHAP_BAR_COLOR)

    ax.set_xlabel("mean(|SHAP value|)")
    ax.set_title(
        f"Overpotential - SHAP Feature Importance\n"
        f"ANN {REPRESENTATION_NAME}",
        fontsize=12
    )

    fig.set_size_inches(6, 5)
    fig.subplots_adjust(
        left=0.32,
        right=0.96,
        bottom=0.13,
        top=0.88
    )
    plt.show()

    # SHAP beeswarm
    plt.figure(figsize=(7, 5))

    shap.plots.beeswarm(
        explanation,
        max_display=SHAP_MAX_DISPLAY,
        color=SHAP_CMAP,
        show=False
    )

    fig = plt.gcf()
    ax = plt.gca()

    ax.set_xlabel(
        "SHAP value (impact on model output)"
    )

    ax.set_title(
        f"Overpotential - SHAP Summary\n"
        f"ANN {REPRESENTATION_NAME}",
        fontsize=12
    )

    fig.set_size_inches(7, 5)
    fig.subplots_adjust(
        left=0.32,
        right=0.90,
        bottom=0.13,
        top=0.88
    )
    plt.show()


