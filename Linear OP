def tune_final_model_grouped(
    X_full,
    y_full,
    groups_full,
    feature_columns,
    categorical_features
):
    """
    Linear Regression 無需 final hyperparameter tuning。
    直接回傳固定 ordinary least-squares 設定。
    """
    result_df = pd.DataFrame([{
        "Parameter": "None",
        "Candidate_Value": "Not applicable",
        "Inner_MAE_Mean": np.nan,
        "Inner_MAE_SD": np.nan,
        "Inner_RMSE_Mean": np.nan,
        "Inner_RMSE_SD": np.nan,
        "Inner_R2_Mean": np.nan,
        "Inner_R2_SD": np.nan
    }])

    best_params = BASE_PARAMS.copy()
    best_value = "Not applicable"
    best_score = np.nan
    return best_params, best_value, best_score, result_df


def calculate_final_model_shap(
    X_full,
    y_full,
    groups_full
):
    """
    1. Full dataset 上做 3-fold literature-grouped tuning
    2. 用最佳參數 fit 完整資料
    3. 對 fit 完的 final Linear Regression 做 Kernel SHAP
    """

    print("\n" + "=" * 78)
    print("FINAL LINEAR REGRESSION MODEL FOR SHAP")
    print("=" * 78)

    final_best_params, final_best_value, final_best_score, final_tuning_df = (
        tune_final_model_grouped(
            X_full=X_full,
            y_full=y_full,
            groups_full=groups_full,
            feature_columns=FEATURE_COLUMNS_MODEL,
            categorical_features=CATEGORICAL_FEATURES
        )
    )

    print("Linear Regression has no hyperparameter tuning step.")
    print("Final model will be fit on the full dataset using ordinary least squares.")

    # --------------------------------------------------------
    # fit final full-data pipeline
    # --------------------------------------------------------
    final_pipeline = build_pipeline(
        FEATURE_COLUMNS_MODEL,
        CATEGORICAL_FEATURES,
        final_best_params
    )
    final_pipeline.fit(X_full, y_full)

    # --------------------------------------------------------
    # SHAP 解釋 Linear Regression 本體。先使用已 fit 的 preprocessor transform，
    # KernelExplainer 直接對數值化後的 SVR model.predict 解釋。
    # --------------------------------------------------------
    fitted_preprocessor = final_pipeline.named_steps["preprocess"]
    fitted_model = final_pipeline.named_steps["model"]

    X_transformed = fitted_preprocessor.transform(X_full)
    X_transformed = np.asarray(X_transformed, dtype=float)

    numerical_features = [
        col for col in FEATURE_COLUMNS_MODEL
        if col not in CATEGORICAL_FEATURES
    ]
    transformed_feature_names = numerical_features + CATEGORICAL_FEATURES

    if X_transformed.shape[1] != len(transformed_feature_names):
        raise ValueError(
            "SHAP feature-name count does not match transformed feature count."
        )

    rng = np.random.default_rng(SHAP_RANDOM_STATE)

    if SHAP_EXPLAIN_SIZE is None:
        explain_idx = np.arange(len(X_transformed))
    else:
        n_explain = min(SHAP_EXPLAIN_SIZE, len(X_transformed))
        explain_idx = np.sort(
            rng.choice(len(X_transformed), size=n_explain, replace=False)
        )

    n_background = min(SHAP_BACKGROUND_SIZE, len(X_transformed))
    background_idx = rng.choice(
        len(X_transformed),
        size=n_background,
        replace=False
    )

    X_explain = X_transformed[explain_idx]
    X_background = X_transformed[background_idx]

    print("\nSHAP setup:")
    print(f"Training samples   : {len(X_transformed)}")
    print(f"Background samples : {len(X_background)}")
    print(f"Explained samples  : {len(X_explain)}")
    print(f"Features           : {len(transformed_feature_names)}")

    explainer = shap.KernelExplainer(
        fitted_model.predict,
        X_background
    )

    shap_values = explainer.shap_values(
        X_explain,
        nsamples=SHAP_NSAMPLES
    )
    shap_values = np.asarray(shap_values)

    # 原參考程式不在圖中顯示 missing-indicator
    shap_keep_idx = [
        i for i, name in enumerate(transformed_feature_names)
        if name != "IR compensation_missing"
    ]

    kept_feature_names = [
        transformed_feature_names[i]
        for i in shap_keep_idx
    ]

    kept_shap_values = shap_values[:, shap_keep_idx]
    kept_X_explain = X_explain[:, shap_keep_idx]

    base_value = explainer.expected_value
    if np.ndim(base_value) == 0:
        base_values = np.repeat(float(base_value), len(X_explain))
    else:
        base_values = np.repeat(float(np.ravel(base_value)[0]), len(X_explain))

    explanation = shap.Explanation(
        values=kept_shap_values,
        base_values=base_values,
        data=kept_X_explain,
        feature_names=kept_feature_names
    )

    mean_abs_shap = np.mean(np.abs(kept_shap_values), axis=0)
    shap_importance_df = (
        pd.DataFrame({
            "Feature": kept_feature_names,
            "Mean_Abs_SHAP": mean_abs_shap
        })
        .sort_values("Mean_Abs_SHAP", ascending=False)
        .reset_index(drop=True)
    )

    return (
        final_pipeline,
        explanation,
        shap_importance_df,
        final_tuning_df,
        final_best_params
    )


