    return best_params, best_value, best_score, candidate_df


# ============================================================
# 7. Literature-level / Cluster Bootstrap 95% CI
#
# Bootstrap 的抽樣單位是 Reference，而不是單筆 row。
# 若某篇文獻被抽到兩次，該文獻的所有 rows 也會被放入兩次。
# ============================================================

def literature_bootstrap_ci(
    prediction_df,
    group_column,
    actual_column="Actual",
    predicted_column="Predicted",
    n_bootstrap=2000,
    ci=95,
    random_state=42
):
    rng = np.random.default_rng(random_state)

    unique_groups = prediction_df[group_column].dropna().unique()
    n_groups = len(unique_groups)

    if n_groups < 2:
        raise ValueError("Bootstrap 至少需要 2 個 literature groups。")

    bootstrap_mae = []
    bootstrap_rmse = []
    bootstrap_r2 = []

    # 先建立 group -> row DataFrame，避免每次重複搜尋
    group_frames = {
        g: prediction_df.loc[prediction_df[group_column] == g].copy()
        for g in unique_groups
    }

    for _ in range(n_bootstrap):
        sampled_groups = rng.choice(
            unique_groups,
            size=n_groups,
            replace=True
        )

        sampled_frames = [group_frames[g] for g in sampled_groups]
        boot_df = pd.concat(sampled_frames, ignore_index=True)

        y_true_boot = boot_df[actual_column].to_numpy(dtype=float)
        y_pred_boot = boot_df[predicted_column].to_numpy(dtype=float)

        metrics = regression_metrics(y_true_boot, y_pred_boot)

        bootstrap_mae.append(metrics["MAE"])
        bootstrap_rmse.append(metrics["RMSE"])

        if np.isfinite(metrics["R2"]):
            bootstrap_r2.append(metrics["R2"])

    alpha = (100 - ci) / 2
    lower_q = alpha
    upper_q = 100 - alpha

    def percentile_ci(values):
        values = np.asarray(values, dtype=float)
        values = values[np.isfinite(values)]

        if len(values) == 0:
            return (np.nan, np.nan)

        return (
            np.percentile(values, lower_q),
            np.percentile(values, upper_q)
        )

    return {
        "MAE": percentile_ci(bootstrap_mae),
        "RMSE": percentile_ci(bootstrap_rmse),
        "R2": percentile_ci(bootstrap_r2)
    }


