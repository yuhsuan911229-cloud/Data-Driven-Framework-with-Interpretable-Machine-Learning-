# ============================================================
# 4. 評估函數
# ============================================================

def regression_metrics(y_true, y_pred):
    """計算 MAE / RMSE / R2。"""
    y_true = np.asarray(y_true, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)

    mae = mean_absolute_error(y_true, y_pred)
    rmse = np.sqrt(mean_squared_error(y_true, y_pred))

    # R2 至少需要兩筆資料；若 target 完全相同也可能沒有意義
    if len(y_true) >= 2:
        r2 = r2_score(y_true, y_pred)
    else:
        r2 = np.nan

    return {
        "MAE": mae,
        "RMSE": rmse,
        "R2": r2
    }


def is_better_score(new_score, best_score, metric_name):
    """判斷新的 inner-CV 分數是否優於目前最佳分數。"""
    if best_score is None:
        return True

    metric_name = metric_name.upper()

    if metric_name in ["RMSE", "MAE"]:
        return new_score < best_score
    elif metric_name == "R2":
        return new_score > best_score
    else:
        raise ValueError("TUNING_METRIC 只能是 'RMSE', 'MAE', 'R2'。")


# ============================================================
# 5. 建立 preprocessing + Linear Regression Pipeline
#
# 重要：
# OrdinalEncoder 與 MinMaxScaler 都放在 Pipeline 裡，
# 因此每次 CV 都只會在當下 training fold 上 fit，避免 leakage。
# ============================================================

def build_pipeline(feature_columns, categorical_features, model_params):
    numerical_features = [
        col for col in feature_columns
        if col not in categorical_features
    ]

    preprocessor = ColumnTransformer(
        transformers=[
            (
                "num",
                MinMaxScaler(),
                numerical_features
            ),
            (
                "cat",
                OrdinalEncoder(
                    handle_unknown="use_encoded_value",
                    unknown_value=-1
                ),
                categorical_features
            )
        ],
        remainder="drop"
    )

    model = LinearRegression(**model_params)

    pipeline = Pipeline(
        steps=[
            ("preprocess", preprocessor),
            ("model", model)
        ]
    )

    return pipeline


# ============================================================
# 6. Linear Regression：保留 nested workflow 介面（無超參數搜尋）
