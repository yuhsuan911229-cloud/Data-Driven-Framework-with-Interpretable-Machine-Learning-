# ============================================================
# 25. SHAP ANALYSIS
# ============================================================

if RUN_FINAL_SHAP:
    print("\n" + "=" * 70)
    print("FINAL RANDOM FOREST SHAP ANALYSIS")
    print("=" * 70)

    final_preprocessor = final_pipeline.named_steps["preprocessor"]
    final_rf = final_pipeline.named_steps["rf"]

    X_transformed = final_preprocessor.transform(X)
    if hasattr(X_transformed, "toarray"):
        X_transformed = X_transformed.toarray()
    X_transformed = np.asarray(X_transformed, dtype=float)

    transformed_feature_names = (
        final_preprocessor.get_feature_names_out().tolist()
    )

    rng = np.random.default_rng(SHAP_RANDOM_STATE)

    if SHAP_EXPLAIN_SIZE is None:
        explain_idx = np.arange(len(X_transformed))
    else:
        n_explain = min(SHAP_EXPLAIN_SIZE, len(X_transformed))
        explain_idx = np.sort(
            rng.choice(len(X_transformed), size=n_explain, replace=False)
        )

    X_explain = X_transformed[explain_idx]

    explainer = shap.TreeExplainer(final_rf)
    shap_values = np.asarray(explainer.shap_values(X_explain))
    expected_value = float(
        np.asarray(explainer.expected_value).reshape(-1)[0]
    )

    shap_keep_idx = [
        i for i, name in enumerate(transformed_feature_names)
        if name != "IR compensation_missing"
    ]

    explanation = shap.Explanation(
        values=shap_values[:, shap_keep_idx],
        base_values=np.repeat(expected_value, len(X_explain)),
        data=X_explain[:, shap_keep_idx],
        feature_names=[
            transformed_feature_names[i] for i in shap_keep_idx
        ],
    )

    print(f"Training samples  : {len(X_transformed)}")
    print(f"Explained samples : {len(X_explain)}")
    print(f"Features          : {len(shap_keep_idx)}")

    # SHAP Feature Importance
    plt.figure(figsize=(6, 5))
    shap.plots.bar(
        explanation,
        max_display=SHAP_MAX_DISPLAY,
        show=False
    )

    fig = plt.gcf()
    ax = plt.gca()

    for patch in ax.patches:
        patch.set_facecolor(SHAP_BAR_COLOR)
        patch.set_edgecolor(SHAP_BAR_COLOR)

    ax.set_xlabel("mean(|SHAP value|)")
    ax.set_title(
        f"Overpotential - SHAP Feature Importance\nRF ({REPRESENTATION_NAME})",
        fontsize=12
    )
    fig.set_size_inches(6, 5)
    fig.subplots_adjust(left=0.32, right=0.96, bottom=0.13, top=0.88)
    plt.show()

    # SHAP Beeswarm
    plt.figure(figsize=(7, 5))
    shap.plots.beeswarm(
        explanation,
        max_display=SHAP_MAX_DISPLAY,
        color=SHAP_CMAP,
        show=False
    )

    fig = plt.gcf()
    ax = plt.gca()
    ax.set_xlabel("SHAP value (impact on model output)")
    ax.set_title(
        f"Overpotential - SHAP Summary\nRF ({REPRESENTATION_NAME})",
        fontsize=12
    )
    fig.set_size_inches(7, 5)
    fig.subplots_adjust(left=0.32, right=0.90, bottom=0.13, top=0.88)
    plt.show()


