# ------------------------------------------------------------
# Calculate Full Range RMSE for each Outer Fold
# ------------------------------------------------------------
full_fold_records = []

for fold in range(1, OUTER_FOLDS + 1):

    # 取出該 Outer Fold 的全部 OOF predictions
    # 不進行任何 target 範圍篩選
    fold_df = oof_predictions.loc[
        oof_predictions["Outer_Fold"] == fold
    ].copy()

    # Calculate Full Range RMSE
    if len(fold_df) == 0:
        fold_rmse = np.nan

    else:
        fold_rmse = np.sqrt(
            mean_squared_error(
                fold_df["Actual"],
                fold_df["Predicted"]
            )
        )

    full_fold_records.append({
        "Model": MODEL_NAME,
        "Dataset": dataset_name,
        "Target": target_name,
        "Range": range_name,
        "Outer_Fold": fold,
        "N_Samples": len(fold_df),
        "RMSE": fold_rmse
    })


# ------------------------------------------------------------
# Convert to DataFrame
# ------------------------------------------------------------
full_fold_rmse_df = pd.DataFrame(
    full_fold_records
)


