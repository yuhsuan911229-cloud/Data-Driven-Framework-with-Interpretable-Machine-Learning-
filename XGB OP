def calculate_validation_loss_curves(
    X_train,
    y_train,
    groups_train,
    feature_columns,
    selected_params,
    outer_fold_label
):

    """
    Calculate XGBoost Training and Validation RMSE curves.

    Validation:
        Inner GroupKFold

    Hyperparameters:
        Selected by the original inner CV tuning.

    Preprocessing:
        Fitted only on each inner training fold.

    Returns:
        DataFrame containing RMSE curves for every inner fold.
    """

    print("\n" + "=" * 70)
    print(
        f"VALIDATION LOSS CURVES - OUTER FOLD "
        f"{outer_fold_label}"
    )
    print("=" * 70)

    # --------------------------------------------------------
    # 1. Create Inner GroupKFold
    # --------------------------------------------------------

    inner_cv = GroupKFold(
        n_splits=INNER_FOLDS
    )

    curve_records = []

    # --------------------------------------------------------
    # 2. Set XGBoost parameters
    # --------------------------------------------------------

    curve_params = selected_params.copy()

    curve_params["n_estimators"] = (
        LOSS_CURVE_N_ESTIMATORS
    )

    curve_params["eval_metric"] = "rmse"

    # --------------------------------------------------------
    # 3. Inner CV
    # --------------------------------------------------------

    for inner_fold, (
        inner_train_idx,
        inner_val_idx
    ) in enumerate(

        inner_cv.split(
            X_train,
            y_train,
            groups_train
        ),

        start=1
    ):

        print(
            f"Processing Inner Fold "
            f"{inner_fold}/{INNER_FOLDS}"
        )

        # ----------------------------------------------------
        # 4. Split data
        # ----------------------------------------------------

        X_inner_train = X_train.iloc[
            inner_train_idx
        ].copy()

        X_inner_val = X_train.iloc[
            inner_val_idx
        ].copy()

        y_inner_train = y_train[
            inner_train_idx
        ]

        y_inner_val = y_train[
            inner_val_idx
        ]

        g_inner_train = groups_train[
            inner_train_idx
        ]

        g_inner_val = groups_train[
            inner_val_idx
        ]

        # ----------------------------------------------------
        # 5. Check publication leakage
        # ----------------------------------------------------

        overlap = (
            set(g_inner_train)
            &
            set(g_inner_val)
        )

        if overlap:

            raise ValueError(
                f"Publication leakage detected: "
                f"Outer Fold {outer_fold_label}, "
                f"Inner Fold {inner_fold}"
            )

        # ----------------------------------------------------
        # 6. Build preprocessing pipeline
        # ----------------------------------------------------

        pipeline = build_pipeline(
            curve_params,
            feature_columns
        )

        preprocessor = pipeline.named_steps[
            "preprocessor"
        ]

        model = pipeline.named_steps[
            "xgb"
        ]

        # ----------------------------------------------------
        # 7. Fit preprocessing on inner training data only
        # ----------------------------------------------------

        X_inner_train_transformed = (
            preprocessor.fit_transform(
                X_inner_train
            )
        )

        X_inner_val_transformed = (
            preprocessor.transform(
                X_inner_val
            )
        )

        # ----------------------------------------------------
        # 8. Train XGBoost and record RMSE
        # ----------------------------------------------------

        model.fit(

            X_inner_train_transformed,
            y_inner_train,

            eval_set=[

                (
                    X_inner_train_transformed,
                    y_inner_train
                ),

                (
                    X_inner_val_transformed,
                    y_inner_val
                )

            ],

            verbose=False

        )

        # ----------------------------------------------------
        # 9. Extract RMSE history
        # ----------------------------------------------------

        eval_results = model.evals_result()

        training_rmse = np.asarray(

            eval_results[
                "validation_0"
            ]["rmse"],

            dtype=float

        )

        validation_rmse = np.asarray(

            eval_results[
                "validation_1"
            ]["rmse"],

            dtype=float

        )

        # ----------------------------------------------------
        # 10. Save every boosting iteration
        # ----------------------------------------------------

        for iteration in range(
            len(validation_rmse)
        ):

            curve_records.append({

                "Outer_Fold":
                    outer_fold_label,

                "Inner_Fold":
                    inner_fold,

                "Number_of_Estimators":
                    iteration + 1,

                "Training_RMSE":
                    training_rmse[iteration],

                "Validation_RMSE":
                    validation_rmse[iteration]

            })

    # --------------------------------------------------------
    # 11. Convert to DataFrame
    # --------------------------------------------------------

    curve_df = pd.DataFrame(
        curve_records
    )

    print(
        "\nValidation loss curves completed."
    )

    return curve_df

def tune_one_parameter_nested(
    X_train,
    y_train,
    groups_train,
    feature_columns,
    outer_fold_label,
):
    """Inner 3-fold literature-grouped univariate tuning."""

    unique_groups = np.unique(groups_train)
    if len(unique_groups) < INNER_FOLDS:
        raise ValueError(
            f"{outer_fold_label}: only {len(unique_groups)} unique publications "
            f"are available for INNER_FOLDS={INNER_FOLDS}."
        )

    inner_cv = GroupKFold(n_splits=INNER_FOLDS)
    candidate_records = []

    print("\n" + "-" * 70)
    print(f"{outer_fold_label} - INNER {INNER_FOLDS}-FOLD GROUPED TUNING")
    print("-" * 70)
    print(f"Tuning parameter : {UNIVARIATE_PARAM_NAME}")
    print(f"Candidates       : {UNIVARIATE_PARAM_VALUES}")
    print(f"Selection metric : {TUNING_METRIC}")

    for candidate in UNIVARIATE_PARAM_VALUES:
        fold_results = []

        current_params = BASE_PARAMS.copy()
        current_params[UNIVARIATE_PARAM_NAME] = candidate

        for inner_fold, (inner_train_idx, inner_val_idx) in enumerate(
            inner_cv.split(X_train, y_train, groups_train), start=1
        ):
            X_inner_train = X_train.iloc[inner_train_idx].copy()
            X_inner_val = X_train.iloc[inner_val_idx].copy()
            y_inner_train = y_train[inner_train_idx]
            y_inner_val = y_train[inner_val_idx]
            g_inner_train = groups_train[inner_train_idx]
            g_inner_val = groups_train[inner_val_idx]

            overlap = set(g_inner_train) & set(g_inner_val)
            if overlap:
                raise ValueError(
                    f"{outer_fold_label}, inner fold {inner_fold}: "
                    f"publication leakage detected: {overlap}"
                )

            pipeline = build_pipeline(current_params, feature_columns)
            pipeline.fit(X_inner_train, y_inner_train)
            y_inner_pred = pipeline.predict(X_inner_val)

            m = regression_metrics(y_inner_val, y_inner_pred)
            fold_results.append(m)

            if PRINT_INNER_DETAILS:
                print(
                    f"{UNIVARIATE_PARAM_NAME}={candidate} | "
                    f"Inner Fold {inner_fold} | "
                    f"MAE={m['MAE']:.4f}, "
                    f"RMSE={m['RMSE']:.4f}, "
                    f"R2={m['R2']:.4f}"
                )

        mean_mae = np.mean([m["MAE"] for m in fold_results])
        sd_mae = np.std([m["MAE"] for m in fold_results], ddof=1)
        mean_rmse = np.mean([m["RMSE"] for m in fold_results])
        sd_rmse = np.std([m["RMSE"] for m in fold_results], ddof=1)
        mean_r2 = np.mean([m["R2"] for m in fold_results])
        sd_r2 = np.std([m["R2"] for m in fold_results], ddof=1)

        candidate_records.append({
            "Outer_Fold": outer_fold_label,
            "Parameter": UNIVARIATE_PARAM_NAME,
            "Candidate": candidate,
            "Mean_MAE": mean_mae,
            "SD_MAE": sd_mae,
            "Mean_RMSE": mean_rmse,
            "SD_RMSE": sd_rmse,
            "Mean_R2": mean_r2,
            "SD_R2": sd_r2,
        })

        print(
            f"  -> {UNIVARIATE_PARAM_NAME}={candidate}: "
            f"Mean MAE={mean_mae:.4f}, "
            f"Mean RMSE={mean_rmse:.4f}, "
            f"Mean R2={mean_r2:.4f}"
        )

    tuning_df = pd.DataFrame(candidate_records)
    metric_upper = TUNING_METRIC.upper()

    if metric_upper == "RMSE":
        best_idx = tuning_df["Mean_RMSE"].astype(float).idxmin()
        best_score = tuning_df.loc[best_idx, "Mean_RMSE"]
    elif metric_upper == "MAE":
        best_idx = tuning_df["Mean_MAE"].astype(float).idxmin()
        best_score = tuning_df.loc[best_idx, "Mean_MAE"]
    elif metric_upper == "R2":
        best_idx = tuning_df["Mean_R2"].astype(float).idxmax()
        best_score = tuning_df.loc[best_idx, "Mean_R2"]
    else:
        raise ValueError('TUNING_METRIC must be "RMSE", "MAE", or "R2".')

    best_value = tuning_df.loc[best_idx, "Candidate"]

    # Keep integer-valued XGBoost parameters as Python int.
    if UNIVARIATE_PARAM_NAME in {"max_depth", "n_estimators", "min_child_weight"}:
        best_value = int(best_value)

    print("\nSelected hyperparameter:")
    print(f"{UNIVARIATE_PARAM_NAME} = {best_value}")
    print(f"Best mean {TUNING_METRIC} = {best_score:.6f}")

    return best_value, tuning_df


def literature_bootstrap_ci(
    prediction_df,
    group_column,
    n_bootstrap=2000,
    ci=95,
    random_state=42,
):
    """Literature-level cluster bootstrap on pooled OOF predictions."""

    rng = np.random.default_rng(random_state)
    unique_groups = prediction_df[group_column].dropna().unique()

    if len(unique_groups) < 2:
        raise ValueError("At least two publications are required for bootstrap CI.")

    records = []

    for _ in range(n_bootstrap):
        sampled_groups = rng.choice(
            unique_groups,
            size=len(unique_groups),
            replace=True
        )

        blocks = []
        for sampled_group in sampled_groups:
            blocks.append(
                prediction_df[prediction_df[group_column] == sampled_group]
            )

        boot = pd.concat(blocks, ignore_index=True)
        yt = boot["Actual"].to_numpy()
        yp = boot["Predicted"].to_numpy()

        mae = mean_absolute_error(yt, yp)
        rmse = np.sqrt(mean_squared_error(yt, yp))

        if len(yt) >= 2 and np.var(yt) > 0:
            r2 = r2_score(yt, yp)
        else:
            r2 = np.nan

        records.append({"MAE": mae, "RMSE": rmse, "R2": r2})

    boot_df = pd.DataFrame(records)
    alpha = (100 - ci) / 2
    ci_result = {}

    for metric in ["MAE", "RMSE", "R2"]:
        values = boot_df[metric].dropna().to_numpy()
        ci_result[metric] = {
            "Lower": np.percentile(values, alpha),
            "Upper": np.percentile(values, 100 - alpha),
        }

    return ci_result, boot_df


def print_metric_with_ci(metric_name, point_value, ci_dict):
    lower = ci_dict[metric_name]["Lower"]
    upper = ci_dict[metric_name]["Upper"]
    print(
        f"{metric_name:<4} = {point_value:.4f} "
        f"(95% CI: {lower:.4f} to {upper:.4f})"
    )


