if RUN_FINAL_SHAP:
    print("\n" + "=" * 70)
    print("FINAL XGBOOST SHAP ANALYSIS")
    print("=" * 70)

    # --------------------------------------------------------
    # 取得 final preprocessing 與 final XGBoost model
    # --------------------------------------------------------
    final_preprocessor = final_pipeline.named_steps["preprocessor"]
    final_xgb = final_pipeline.named_steps["xgb"]

    # --------------------------------------------------------
    # 將完整資料使用 final preprocessing 轉換
    # --------------------------------------------------------
    X_transformed = final_preprocessor.transform(X)

    if hasattr(X_transformed, "toarray"):
        X_transformed = X_transformed.toarray()

    X_transformed = np.asarray(
        X_transformed,
        dtype=float
    )
    # 取得 preprocessing 後的 feature names
    transformed_feature_names = (
        final_preprocessor
        .get_feature_names_out()
        .tolist()
    )
    # --------------------------------------------------------
    # 選擇要解釋的 samples
    # --------------------------------------------------------
    rng = np.random.default_rng(
        SHAP_RANDOM_STATE
    )
    if SHAP_EXPLAIN_SIZE is None:
        explain_idx = np.arange(
            len(X_transformed)
        )
    else:
        n_explain = min(
            SHAP_EXPLAIN_SIZE,
            len(X_transformed)
        )

        explain_idx = np.sort(
            rng.choice(
                len(X_transformed),
                size=n_explain,
                replace=False
            )
        )
    X_explain = X_transformed[
        explain_idx
    ]
    # ========================================================
    # XGBoost native SHAP
    #
    # 使用 XGBoost 原生 pred_contribs=True
    # 不使用 shap.TreeExplainer
    # ========================================================
    booster = final_xgb.get_booster()
    dmat_explain = xgb.DMatrix(
        X_explain,
        feature_names=transformed_feature_names
    )

    shap_contributions = booster.predict(
        dmat_explain,
        pred_contribs=True
    )
    # --------------------------------------------------------
    # pred_contribs 的最後一欄為 bias / base value
    # 前面所有欄位才是各 feature 的 SHAP values
    # --------------------------------------------------------
    shap_values = (
        shap_contributions[:, :-1]
    )

    base_values = (
        shap_contributions[:, -1]
    )
    # --------------------------------------------------------
    # 不將 IR compensation_missing
    # 顯示於 SHAP importance 與 beeswarm
    # --------------------------------------------------------
    shap_keep_idx = [
        i
        for i, name
        in enumerate(transformed_feature_names)
        if name != "IR compensation_missing"
    ]
    # --------------------------------------------------------
    # 建立 SHAP Explanation
    # --------------------------------------------------------
    explanation = shap.Explanation(
        values=shap_values[
            :, shap_keep_idx
        ],

        base_values=base_values,

        data=X_explain[
            :, shap_keep_idx
        ],

        feature_names=[
            transformed_feature_names[i]
            for i in shap_keep_idx
        ],
    )
    # --------------------------------------------------------
    # 印出 SHAP feature importance
    # --------------------------------------------------------
    mean_abs_shap = np.abs(
        explanation.values
    ).mean(axis=0)

    sorted_index = np.argsort(
        mean_abs_shap
    )[::-1]
    print(
        "\nSHAP Feature Importance:"
    )

    for i in sorted_index:
        print(
            f"{explanation.feature_names[i]}: "
            f"{mean_abs_shap[i]:.4f}"
        )

    print(
        f"\nTraining samples  : "
        f"{len(X_transformed)}"
    )

    print(
        f"Explained samples : "
        f"{len(X_explain)}"
    )

    print(
        f"Features shown    : "
        f"{len(shap_keep_idx)}"
    )
    # ========================================================
    # SHAP Feature Importance
    # ========================================================
    plt.figure(
        figsize=(6, 5)
    )

    shap.plots.bar(
        explanation,
        max_display=SHAP_MAX_DISPLAY,
        show=False
    )
    fig = plt.gcf()
    ax = plt.gca()
    for patch in ax.patches:
        patch.set_facecolor(
            SHAP_BAR_COLOR
        )

        patch.set_edgecolor(
            SHAP_BAR_COLOR
        )
    ax.set_xlabel(
        "mean(|SHAP value|)"
    )
    ax.set_title(
        f"Overpotential - SHAP Feature Importance\n"
        f"XGB ({REPRESENTATION_NAME})",
        fontsize=12
    )
    fig.set_size_inches(
        6,
        5
    )
    fig.subplots_adjust(
        left=0.32,
        right=0.96,
        bottom=0.13,
        top=0.88
    )
    plt.show()
    # ========================================================
    # SHAP Beeswarm
    # ========================================================
    plt.figure(
        figsize=(7, 5)
    )
    shap.plots.beeswarm(
        explanation,
        max_display=SHAP_MAX_DISPLAY,
        color=SHAP_CMAP,
        show=False
    )
    fig = plt.gcf()
    ax = plt.gca()
    ax.set_xlabel(
        "SHAP value (impact on model output)"
    )
    ax.set_title(
        f"Overpotential - SHAP Summary\n"
        f"XGB ({REPRESENTATION_NAME})",
        fontsize=12
    )
    fig.set_size_inches(
        7,
        5
    )
